# Database - PostgreSQL primary, PGlite fallback when absent
DATABASE_URL=

# Moss - fast semantic retrieval
MOSS_PROJECT_ID=
MOSS_PROJECT_KEY=
MOSS_INDEX_NAME=mission-room-knowledge

# LiveKit - realtime collaboration
NEXT_PUBLIC_LIVEKIT_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# LLM - provider abstraction (OpenAI compatible)
OPENAI_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b

# Email - Resend or SMTP
RESEND_API_KEY=
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
ALERT_FROM_EMAIL=alert@bluesentinel.local
ALERT_TO_EMAIL=operator@bluesentinel.local

# Copernicus - LIVE Sentinel-1 (STAC + Process API via OAuth) — CANONICAL NAMES
COPERNICUS_CLIENT_ID=
COPERNICUS_CLIENT_SECRET=
# Deprecated aliases (backward compat, prefer COPERNICUS_*): if COPERNICUS_* not set, SENTINEL_HUB_* will be used
# SENTINEL_HUB_CLIENT_ID=
# SENTINEL_HUB_CLIENT_SECRET=

# App
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_APP_URL=http://localhost:3000
